  File adjusted for Star Wars D20
-->

<root>
	<!-- Parent Weapon Windowclass -->
	<windowclass name="char_weapon">
		<margins control="0,0,0,5" />
		<script file="campaign/scripts/char_weapon.lua" />
		<sheetdata>
			<anchor_listitem_left />
			<anchor_listitem_right />
			<anchor_listitem_top />

			<!-- Left controls -->
			<button_listitem_idelete_left name="idelete" />
			<link_listitem_left name="shortcut" />
			<button_listitem_carried_left name="carried" />
			<state_charweapontype name="type">
				<anchored to="leftanchor" width="20" height="20">
					<top />
					<left relation="relative" offset="0" postoffset="0" />
				</anchored>
			</state_charweapontype>

			<!-- Weapon Name -->
			<string_listitem_center_underline name="name" />

			<!-- Nested Child Actions List -->
			<list_content_noscroll_top name="action_list">
				<anchored>
					<top parent="name" anchor="bottom" offset="3" />
					<left offset="35" />
					<right offset="-5" />
				</anchored>
				<datasource>.actionlist</datasource>
				<class>char_weapon_item</class>
				<sortby><control>name</control></sortby>
			</list_content_noscroll_top>
		</sheetdata>
	</windowclass>

	<!-- Child Action Windowclass -->
	<windowclass name="char_weapon_item">
		<margins control="0,0,0,2" />
		<script file="campaign/scripts/char_weapon_action_sw.lua" />
		<sheetdata>
			<anchor_listitem_left />
			<anchor_listitem_right />
			<anchor_listitem_top />

			<hn name="atktype" />

			<!-- Left side -->
			<button_listitem_idelete_left name="idelete" />

			<!-- Row 1: 1. Attack Button (Sword) -->
			<buttoncontrol name="button_attack">
				<anchored to="leftanchor" width="20" height="20">
					<top />
					<left relation="relative" offset="2" postoffset="2" />
				</anchored>
				<icon normal="button_action_attack" pressed="button_action_attack_down" />
				<script>
					function onButtonPress(x, y)
						window.onFullAttackAction();
					end
					function onDragStart(button, x, y, draginfo)
						return window.onFullAttackAction(draginfo);
					end
				</script>
			</buttoncontrol>

			<!-- Row 1: 2. Fire Mode Button (S/M/A) in between Attack and Damage (hidden for melee) -->
			<button_stringcycler name="firemode">
				<anchored to="button_attack" position="righthigh" offset="6,0" width="20" height="20" />
				<parameters>
					<defaultlabelres>char_menu_firemode_s</defaultlabelres>
					<labelsres>char_menu_firemode_m|char_menu_firemode_a</labelsres>
					<values>multifire|autofire</values>
				</parameters>
				<script>
					function onValueChanged()
						window.onAttackChanged();
						window.updateFireModeTooltip();
					end
				</script>
			</button_stringcycler>

			<!-- Row 1: 3. Damage Button (Blood drop) fixed offset from Attack button so Damage always vertically aligns -->
			<buttoncontrol name="button_damage">
				<anchored to="button_attack" position="righthigh" offset="32,0" width="20" height="20" />
				<icon normal="button_action_damage" pressed="button_action_damage_down" />
				<script>
					function onButtonPress(x, y)
						window.onDamageAction();
					end
					function onDragStart(button, x, y, draginfo)
						return window.onDamageAction(draginfo);
					end
				</script>
			</buttoncontrol>

			<!-- Row 1: 4. Damage Value Box (e.g. 3d6 Energy) -->
			<stringcontrol name="damageview">
				<anchored to="button_damage" position="righthigh" offset="6,0" width="85" height="20" />
				<readonly />
				<frame name="fielddark" offset="7,5,7,5" />
				<cursor hover="hand" />
				<script>
					function onDragStart(button, x, y, draginfo)
						return window.onDamageAction(draginfo);
					end
					function onDoubleClick(x, y)
						return window.onDamageAction();
					end
				</script>
			</stringcontrol>

			<!-- Row 1: 5. Details Gear Icon (Far Right) -->
			<buttonc_listitem_right name="activatedetail">
				<icon normal="button_details" pressed="button_details_down" />
				<script>
					function onButtonPress()
						Interface.openWindow("char_weapon_editor", window.getDatabaseNode());
					end
				</script>
			</buttonc_listitem_right>

			<!-- Row 1: 6. Action Name Underline (Fills between Damage and Details) -->
			<string_listitem_center_underline name="name">
				<anchored>
					<left parent="damageview" anchor="right" offset="10" />
					<right parent="rightanchor" relation="relative" offset="-5" />
				</anchored>
			</string_listitem_center_underline>

			<!-- Row 2: Attack Bonus Boxes (+8, +3...) on their own line below Row 1 -->
			<genericcontrol name="attackview">
				<anchored to="button_attack" position="belowleft" offset="0,3" height="20" width="138" />
				<frame name="slottedmodifier" offset="5,5,5,5" width="138" />
			</genericcontrol>
			<numbercontrol name="attackview1">
				<anchored to="attackview" position="insidetopleft" offset="1,0" width="30" height="20" />
				<font>sheetnumber</font>
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(1); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(1, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview2">
				<anchored to="attackview1" position="righthigh" offset="2,0" width="30" height="20" />
				<font>sheetnumber</font>
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(2); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(2, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview3">
				<anchored to="attackview2" position="righthigh" offset="2,0" width="30" height="20" />
				<font>sheetnumber</font>
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(3); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(3, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview4">
				<anchored to="attackview3" position="righthigh" offset="2,0" width="30" height="20" />
				<font>sheetnumber</font>
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(4); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(4, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview5">
				<anchored to="attackview4" position="righthigh" offset="2,0" width="30" height="20" />
				<font>sheetnumber</font>
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(5); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(5, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview6">
				<anchored to="attackview5" position="righthigh" offset="2,0" width="30" height="20" />
				<font>sheetnumber</font>
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(6); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(6, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview7">
				<anchored to="attackview6" position="righthigh" offset="2,0" width="30" height="20" />
				<font>sheetnumber</font>
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(7); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(7, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview8">
				<anchored to="attackview7" position="righthigh" offset="2,0" width="30" height="20" />
				<font>sheetnumber</font>
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(8); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(8, draginfo); end
				</script>
			</numbercontrol>

			<!-- Row 3: Ammo row below attackview (if ranged with ammo) -->
			<number_content_base name="maxammo">
				<anchored to="attackview" position="belowleft" offset="0,3" width="30" height="18" />
				<frame name="fielddark" offset="5,5,5,5" />
				<min>0</min>
				<max>500</max>
			</number_content_base>
			<label name="label_ammo">
				<anchored to="maxammo" position="righthigh" offset="6,0" width="45" height="18" />
				<static textres="char_label_weaponammo" />
			</label>
			<state_charammocounter name="ammocounter">
				<anchored to="label_ammo" position="righthigh" offset="8,0" height="18" />
				<maxslotperrow>25</maxslotperrow>
			</state_charammocounter>
		</sheetdata>
	</windowclass>
	
	<!-- Action Editor -->
	<windowclass name="char_weapon_editor" copy="charsheethelper_base">
		<sizelimits>
			<minimum width="420" height="480" />
		</sizelimits>
		<sheetdata>
			<windowtitlebar_charsheethelper name="title">
				<resource>weapon_title</resource>
			</windowtitlebar_charsheethelper>
			<sub_content_framed_groupbox name="content">
				<class>char_weapon_editor_main</class>
			</sub_content_framed_groupbox>
		</sheetdata>
	</windowclass>

	<windowclass name="char_weapon_editor_main">
		<sheetdata>
			<anchor_column name="columnanchor" />

			<!-- Top Weapon Node Section -->
			<label_column>
				<static textres="weapon_label_weapon" />
			</label_column>
			<string_column name="weapon_name" source="...name" />

			<label_column>
				<static textres="weapon_label_properties" />
			</label_column>
			<string_column name="properties" source="...properties">
				<delaykeyupdate />
			</string_column>
			
			<label_column>
				<static textres="weapon_label_firingmodes" />
			</label_column>
			<string_column name="firingmodes" source="...firingmodes">
				<script file="custom/scripts/string_autofill_sw.lua" />
				<target>firingmodes</target>
			</string_column>

			<label_column name="label_rangeincrement">
				<static textres="char_label_weaponrange" />
			</label_column>
			<number_column name="rangeincrement" source="...rangeincrement">
				<min>0</min>
			</number_column>

			<label_column name="label_maxammo">
				<static textres="char_label_weaponammo" />
			</label_column>
			<number_column name="maxammo" source="...maxammo">
				<min>0</min>
				<max>500</max>
			</number_column>

			<!-- Stats Section (Action/Row level) -->
			<header_column name="header_stats">
				<static textres="weapon_header_stats" />
				<center />
			</header_column>

			<label_column>
				<static textres="weapon_label_note" />
			</label_column>
			<string_column name="name" />

			<label_column>
				<static textres="weapon_label_type" />
			</label_column>
			<button_stringcycler name="atktype">
				<anchored width="60" height="20">
					<top parent="columnanchor" anchor="bottom" relation="relative" offset="7" />
					<left offset="97" />
				</anchored>
				<source type="number">atktype</source>
				<parameters>
					<defaultlabelres>char_actions_wpn_editor_type_melee</defaultlabelres>
					<labelsres>char_actions_wpn_editor_type_ranged|char_actions_wpn_editor_type_thrown</labelsres>
					<values>1|2</values>
				</parameters>
			</button_stringcycler>

			<!-- Attack Config -->
			<header_column name="header_attack">
				<static textres="weapon_header_attack" />
				<center />
			</header_column>
			
			<label_column>
				<static textres="weapon_label_attacks" />
			</label_column>
			<number_column name="attacks">
				<default>1</default>
				<min>1</min>
				<max>4</max>
			</number_column>
			
			<cycler_ability name="attackstat">
				<anchored width="40" height="20">
					<top parent="columnanchor" anchor="bottom" relation="relative" offset="22" />
					<left offset="5" />
				</anchored>
			</cycler_ability>
			<label_fieldtop>
				<anchored to="attackstat" />
				<static textres="weapon_label_atkstat" />
			</label_fieldtop>
			<label name="label_atkplus">
				<anchored to="attackstat" position="righthigh" offset="5,0" width="10" />
				<static>+</static>
				<center />
			</label>
			<basicnumber name="bonus">
				<anchored to="label_atkplus" position="righthigh" offset="5,0" width="30" height="20" />
				<hideonvalue>0</hideonvalue>
			</basicnumber>
			<label_fieldtop>
				<anchored to="bonus" />
				<static textres="weapon_label_atkbonus" />
			</label_fieldtop>
			<label name="label_atkplus2">
				<anchored to="bonus" position="righthigh" offset="5,0" width="10" />
				<static>+</static>
				<center />
			</label>
			<genericcontrol name="attackmodframe">
				<anchored to="label_atkplus2" position="righthigh" offset="2,0" width="130" height="20" />
				<frame name="slottedmodifier" offset="5,5,5,6" />
			</genericcontrol>
			<number_charweaponattackmod name="attack1modifier">
				<anchored to="attackmodframe" position="insidetopleft" offset="3,0" width="27" height="20" />
			</number_charweaponattackmod>
			<number_charweaponattackmod name="attack2modifier">
				<anchored to="attack1modifier" position="right" offset="5,0" width="27" />
			</number_charweaponattackmod>
			<number_charweaponattackmod name="attack3modifier">
				<anchored to="attack2modifier" position="right" offset="5,0" width="27" />
			</number_charweaponattackmod>
			<number_charweaponattackmod name="attack4modifier">
				<anchored to="attack3modifier" position="right" offset="5,0" width="27" />
			</number_charweaponattackmod>
			<label_fieldtop>
				<anchored to="attackmodframe" />
				<static textres="weapon_label_atkbonusper" />
			</label_fieldtop>
			
			<basicnumber name="critatkrange">
				<anchored height="20" width="25">
					<top parent="attackstat" />
					<right offset="-10" />
				</anchored>
				<default>20</default>
				<min>2</min>
				<max>20</max>
			</basicnumber>
			<label_fieldtop>
				<anchored to="critatkrange" />
				<static textres="weapon_label_critrange" />
			</label_fieldtop>

			<!-- Damage Config (Flattened) -->
			<header_column name="header_damage">
				<static textres="weapon_header_damage" />
				<center />
			</header_column>

			<basicdice name="dice">
				<anchored width="60" height="20">
					<top parent="columnanchor" anchor="bottom" relation="relative" offset="22" />
					<left offset="5" />
				</anchored>
			</basicdice>
			<label_fieldtop>
				<anchored to="dice" />
				<static textres="weapon_label_dmgdice" />
			</label_fieldtop>

			<label name="label_dmgplus">
				<anchored to="dice" position="righthigh" offset="5,0" width="10" />
				<static>+</static>
				<center />
			</label>

			<basicnumber name="damagestatmult">
				<anchored to="label_dmgplus" position="righthigh" offset="5,0" width="20" height="20" />
				<default>1</default>
				<min>0.5</min>
				<wheel>0.5</wheel>
				<hideonvalue>1</hideonvalue>
				<tooltip textres="weapon_tooltip_dmgstatmult" />
			</basicnumber>
			<label name="label_statmultx">
				<anchored to="damagestatmult" position="righthigh" offset="2,0" width="10" />
				<static>x</static>
				<center />
			</label>

			<cycler_ability name="damagestat">
				<anchored to="label_statmultx" position="righthigh" offset="5,0" width="40" height="20" />
				<parameters>
					<defaultlabelres>dash</defaultlabelres>
				</parameters>
			</cycler_ability>
			<label_fieldtop>
				<anchored to="damagestat" />
				<static textres="weapon_label_atkstat" />
			</label_fieldtop>

			<label name="label_dmgplus2">
				<anchored to="damagestat" position="righthigh" offset="5,0" width="10" />
				<static>+</static>
				<center />
			</label>

			<basicnumber name="damagebonus">
				<anchored to="label_dmgplus2" position="righthigh" offset="5,0" width="30" height="20" />
				<hideonvalue>0</hideonvalue>
			</basicnumber>
			<label_fieldtop>
				<anchored to="damagebonus" />
				<static textres="weapon_label_dmgbonus" />
			</label_fieldtop>

			<basicnumber name="critdmgmult">
				<anchored height="20" width="25">
					<top parent="dice" />
					<right offset="-10" />
				</anchored>
				<default>2</default>
				<min>1</min>
				<max>5</max>
			</basicnumber>
			<label_fieldtop>
				<anchored to="critdmgmult" />
				<static textres="weapon_label_dmgcritmult" />
			</label_fieldtop>
			<label name="label_critmultx">
				<anchored to="critdmgmult" position="lefthigh" offset="2,0" width="10" />
				<static>x</static>
				<center />
			</label>

			<label_column>
				<static textres="weapon_label_dmgtype" />
			</label_column>
			<string_column name="damagetype">
				<script file="custom/scripts/string_autofill_sw.lua" />
				<target>wpn_autofill_dmgtypes</target>
			</string_column>
		</sheetdata>
	</windowclass>
</root>
