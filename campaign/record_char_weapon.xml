<root>
	<windowclass name="char_weapon">
		<margins control="0,0,0,5" />
		<script file="campaign/scripts/char_weapon.lua" />
		<sheetdata>
			<anchor_listitem_left />
			<anchor_listitem_right />
			<anchor_listitem_top />

			<!-- Left side controls -->
			<button_listitem_idelete_left name="idelete" />
			<link_listitem_left name="shortcut" />
			<button_listitem_carried_left name="carried" />
			<state_charweapontype name="type">
				<anchored to="leftanchor" width="20" height="20">
					<top />
					<left relation="relative" offset="0" postoffset="0" />
				</anchored>
			</state_charweapontype>

			<!-- Right side controls (ordered right-to-left relative to rightanchor) -->
			<buttonc_listitem_right name="activatedetail">
				<icon normal="button_details" pressed="button_details_down" />
				<script>
					function onButtonPress()
						Interface.openWindow("char_weapon_editor", window.getDatabaseNode());
					end
				</script>
			</buttonc_listitem_right>

			<!-- Damage Value Box -->
			<stringcontrol name="damageview">
				<anchored width="85" height="20">
					<top parent="rightanchor" />
					<right parent="rightanchor" relation="relative" offset="-5" postoffset="-5" />
				</anchored>
				<readonly />
				<frame name="fielddark" offset="7,5,7,5" />
				<cursor hover="hand" />
				<script>
					function onDragStart(button, x, y, draginfo)
						return window.onDamageAction(draginfo);
					end
					function onDoubleClick(x, y)
						return window.onDamageAction();
					end
				</script>
			</stringcontrol>

			<!-- Damage Button (Blood Drop) -->
			<buttoncontrol name="button_damage">
				<anchored width="20" height="20">
					<top parent="rightanchor" />
					<right parent="rightanchor" relation="relative" offset="-5" postoffset="-5" />
				</anchored>
				<icon normal="button_action_damage" pressed="button_action_damage_down" />
				<script>
					function onButtonPress(x, y)
						window.onDamageAction();
					end
					function onDragStart(button, x, y, draginfo)
						return window.onDamageAction(draginfo);
					end
				</script>
			</buttoncontrol>

			<!-- Fortitude Attack Button (Stun) -->
			<buttoncontrol name="button_stun">
				<anchored width="20" height="20">
					<top parent="rightanchor" />
					<right parent="rightanchor" relation="relative" offset="-5" postoffset="-5" />
				</anchored>
				<icon normal="button_action_effect" pressed="button_action_effect_down" />
				<tooltip textres="char_tooltip_actionstun" />
				<script>
					function onButtonPress(x, y)
						window.onFortitudeAction();
					end
					function onDragStart(button, x, y, draginfo)
						return window.onFortitudeAction(draginfo);
					end
				</script>
			</buttoncontrol>

			<!-- Attack Button (Sword) -->
			<buttoncontrol name="button_attack">
				<anchored width="20" height="20">
					<top parent="rightanchor" />
					<right parent="rightanchor" relation="relative" offset="-5" postoffset="-5" />
				</anchored>
				<icon normal="button_action_attack" pressed="button_action_attack_down" />
				<script>
					function onButtonPress(x, y)
						window.onFullAttackAction();
					end
					function onDragStart(button, x, y, draginfo)
						return window.onFullAttackAction(draginfo);
					end
				</script>
			</buttoncontrol>

			<!-- Weapon Name (Fills the space on the left between Type and Attack) -->
			<string_listitem_center_underline name="name" />

			<!-- Row 2: Details Area -->
			<area_content_top name="area_details_row2">
				<anchored height="20">
					<top parent="name" anchor="bottom" relation="relative" offset="4" />
					<left parent="" offset="20" />
					<right parent="" offset="-5" />
				</anchored>
			</area_content_top>

			<label name="label_firemode">
				<anchored to="area_details_row2" position="insidetopleft" offset="0,0" width="45" />
				<static textres="char_label_firemode" />
			</label>
			<button_stringcycler name="firemode">
				<anchored to="label_firemode" position="righthigh" offset="10,0" width="40" height="20" />
				<frame name="fielddark" offset="5,5,5,5" />
				<stateframe>
					<hover name="fieldfocus" offset="5,5,5,5" />
				</stateframe>
				<parameters>
					<defaultlabelres>char_menu_firemode_s</defaultlabelres>
					<labelsres>char_menu_firemode_m|char_menu_firemode_a</labelsres>
					<values>multifire|autofire</values>
				</parameters>
				<script>
					function onValueChanged()
						window.onAttackChanged();
						window.updateFireModeTooltip();
					end
				</script>
			</button_stringcycler>

			<!-- Row 2: Attack view modifier slots to the right of firemode -->
			<genericcontrol name="attackview">
				<anchored to="firemode" position="righthigh" offset="15,0" height="20" />
				<frame name="slottedmodifier" offset="5,5,5,5" width="266" />
			</genericcontrol>
			<numbercontrol name="attackview1">
				<anchored to="attackview" position="insidetopleft" offset="1,0" width="30" height="20" />
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(1); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(1, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview2">
				<anchored to="attackview1" position="righthigh" offset="2,0" width="30" height="20" />
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(2); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(2, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview3">
				<anchored to="attackview2" position="righthigh" offset="2,0" width="30" height="20" />
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(3); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(3, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview4">
				<anchored to="attackview3" position="righthigh" offset="2,0" width="30" height="20" />
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(4); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(4, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview5">
				<anchored to="attackview4" position="righthigh" offset="2,0" width="30" height="20" />
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(5); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(5, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview6">
				<anchored to="attackview5" position="righthigh" offset="2,0" width="30" height="20" />
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(6); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(6, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview7">
				<anchored to="attackview6" position="righthigh" offset="2,0" width="30" height="20" />
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(7); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(7, draginfo); end
				</script>
			</numbercontrol>
			<numbercontrol name="attackview8">
				<anchored to="attackview7" position="righthigh" offset="2,0" width="30" height="20" />
				<displaysign />
				<script>
					function onClickDown() return true; end
					function onClickRelease(x, y) return window.onSingleAttackAction(8); end
					function onDragStart(button, x, y, draginfo) return window.onSingleAttackAction(8, draginfo); end
				</script>
			</numbercontrol>

			<!-- Row 3: Ranged / Ammo Details Section -->
			<sub_content_column name="sub_ranged">
				<anchored>
					<top parent="area_details_row2" anchor="bottom" relation="relative" offset="4" />
					<left parent="" offset="20" />
				</anchored>
			</sub_content_column>
		</sheetdata>
	</windowclass>

	<windowclass name="char_weapon_ranged">
		<margins control="0,0,0,2" />
		<script>
			function onInit()
				self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
			end
			function onLockModeChanged(bReadOnly)
				if parentcontrol and parentcontrol.window.minisheet then
					bReadOnly = true;
				end

				local tFields = { "rangeincrement", };
				WindowManager.callSafeControlsSetLockMode(self, tFields, bReadOnly);

				local bShowRange = not bReadOnly or (rangeincrement.getValue() ~= 0);
				WindowManager.callSafeControlsSetVisible(self, { "label_rangeincrement", "rangeincrement", }, bShowRange);

				local bShowAmmo = not bReadOnly or (maxammo.getValue() ~= 0);
				WindowManager.callSafeControlsSetVisible(self, { "label_ammo", "maxammo", "ammocounter", }, bShowAmmo);
			end
		</script>
		<sheetdata>
			<anchor_content_top />

			<!-- Spacer to prevent ammo counter clipping -->
			<spacer_content_top>
				<anchored height="2" />
			</spacer_content_top>
			
			<area_content_top name="area_details">
				<anchored height="20" />
			</area_content_top>

			<label name="label_rangeincrement">
				<anchored to="area_details" position="insidetopleft" offset="0,0" width="45" />
				<static textres="char_label_weaponrange" />
			</label>
			<number_content_base name="rangeincrement">
				<anchored to="label_rangeincrement" position="righthigh" offset="10,0" width="40" />
				<frame name="fielddark" offset="5,5,5,5" />
				<min>0</min>
			</number_content_base>

			<label name="label_ammo">
				<anchored to="rangeincrement" position="righthigh" offset="10,0" width="45" />
				<static textres="char_label_weaponammo" />
			</label>
			<number_content_base name="maxammo">
				<anchored to="label_ammo" position="righthigh" offset="10,0" width="40" />
				<frame name="fielddark" offset="5,5,5,5" />
				<min>0</min>
				<max>500</max>
			</number_content_base>
			<state_charammocounter name="ammocounter">
				<anchored to="maxammo" height="20">
					<top />
					<left relation="relative" offset="8" postoffset="5" />
				</anchored>
			</state_charammocounter>
		</sheetdata>
	</windowclass>
	
	<windowclass name="char_weapon_editor" copy="charsheethelper_base">
		<sizelimits>
			<minimum width="400" height="450" />
		</sizelimits>
		<sheetdata>
			<windowtitlebar_charsheethelper name="title">
				<resource>weapon_title</resource>
			</windowtitlebar_charsheethelper>
			<sub_content_framed_groupbox name="content">
				<class>char_weapon_editor_main</class>
			</sub_content_framed_groupbox>
		</sheetdata>
	</windowclass>

	<windowclass name="char_weapon_editor_main">
		<script>
			function onDrop(x, y, draginfo)
				local sDragType = draginfo.getType();
				
				if sDragType == "dice" then
					local w = list.createWindow();
					for _, vDie in ipairs(draginfo.getDiceData()) do
						w.dice.addDie(vDie.type);
					end
					return true;
				elseif sDragType == "number" then
					local w = list.createWindow();
					w.bonus.setValue(draginfo.getNumberData());
					return true;
				end
			end
		</script>
		<sheetdata>
			<anchor_column name="columnanchor" />

			<label_column>
				<static textres="weapon_label_name" />
			</label_column>
			<string_column name="name" />
			
			<label_column>
				<static textres="weapon_label_properties" />
			</label_column>
			<string_column name="properties">
				<delaykeyupdate />
			</string_column>
			
			<label_column>
				<static textres="weapon_label_firingmodes" />
			</label_column>
			<button_stringcycler name="firingmodes">
				<anchored width="80" height="20">
					<top parent="columnanchor" anchor="bottom" relation="relative" offset="7" />
					<left offset="97" />
				</anchored>
				<parameters>
					<defaultlabel>-</defaultlabel>
					<labels>M|M/A|M/A only</labels>
					<values>M|M/A|M/A only</values>
				</parameters>
			</button_stringcycler>

			<label_column name="label_rangeincrement">
				<static textres="char_label_weaponrange" />
			</label_column>
			<number_column name="rangeincrement">
				<min>0</min>
			</number_column>

			<label_column name="label_maxammo">
				<static textres="char_label_weaponammo" />
			</label_column>
			<number_column name="maxammo">
				<min>0</min>
				<max>500</max>
			</number_column>

			<label_column name="label_stundc">
				<static textres="item_label_stundc" />
			</label_column>
			<number_column name="stundc">
				<min>0</min>
			</number_column>

			<!-- Attack -->
			<header_column name="header_attack">
				<static textres="weapon_header_attack" />
				<center />
			</header_column>
			
			<label_column>
				<static textres="weapon_label_attacks" />
			</label_column>
			<number_column name="attacks">
				<default>1</default>
				<min>1</min>
				<max>4</max>
			</number_column>
			
			<cycler_ability name="attackstat">
				<anchored width="40" height="20">
					<top parent="columnanchor" anchor="bottom" relation="relative" offset="22" />
					<left offset="5" />
				</anchored>
			</cycler_ability>
			<label_fieldtop>
				<anchored to="attackstat" />
				<static textres="weapon_label_atkstat" />
			</label_fieldtop>
			<label name="label_atkplus">
				<anchored to="attackstat" position="righthigh" offset="5,0" width="10" />
				<static>+</static>
				<center />
			</label>
			<basicnumber name="bonus">
				<anchored to="label_atkplus" position="righthigh" offset="5,0" width="30" height="20" />
				<hideonvalue>0</hideonvalue>
			</basicnumber>
			<label_fieldtop>
				<anchored to="bonus" />
				<static textres="weapon_label_atkbonus" />
			</label_fieldtop>
			<label name="label_atkplus2">
				<anchored to="bonus" position="righthigh" offset="5,0" width="10" />
				<static>+</static>
				<center />
			</label>
			<genericcontrol name="attackmodframe">
				<anchored to="label_atkplus2" position="righthigh" offset="2,0" width="130" height="20" />
				<frame name="slottedmodifier" offset="5,5,5,6" />
			</genericcontrol>
			<number_charweaponattackmod name="attack1modifier">
				<anchored to="attackmodframe" position="insidetopleft" offset="3,0" width="27" height="20" />
			</number_charweaponattackmod>
			<number_charweaponattackmod name="attack2modifier">
				<anchored to="attack1modifier" position="right" offset="5,0" width="27" />
			</number_charweaponattackmod>
			<number_charweaponattackmod name="attack3modifier">
				<anchored to="attack2modifier" position="right" offset="5,0" width="27" />
			</number_charweaponattackmod>
			<number_charweaponattackmod name="attack4modifier">
				<anchored to="attack3modifier" position="right" offset="5,0" width="27" />
			</number_charweaponattackmod>
			<label_fieldtop>
				<anchored to="attackmodframe" />
				<static textres="weapon_label_atkbonusper" />
			</label_fieldtop>
			
			<basicnumber name="critatkrange">
				<anchored height="20" width="25">
					<top parent="attackstat" />
					<right offset="-10" />
				</anchored>
				<default>20</default>
				<min>2</min>
				<max>20</max>
			</basicnumber>
			<label_fieldtop>
				<anchored to="critatkrange" />
				<static textres="weapon_label_critrange" />
			</label_fieldtop>

			<!-- Damage -->
			<header_column name="header_damage">
				<static textres="weapon_header_damage" />
				<center />
			</header_column>
			<button_iedit name="list_iedit">
				<anchored to="header_damage" position="insidetopright" offset="-5,0" />
				<edittarget>list</edittarget>
			</button_iedit>
			<button_iadd name="list_iadd">
				<anchored to="list_iedit" position="lefthigh" offset="5,0" />
			</button_iadd>

			<list_editor name="list">
				<datasource>.damagelist</datasource>
				<class>char_weapon_damage_entry</class>
				<childfocus>type</childfocus>
				<script>
					function onChildWindowCreated(w)
						if getWindowCount() == 1 then
							if DB.getValue(window.getDatabaseNode(), "type", 0) ~= 1 then
								w.stat.setValue("strength");
							end
							w.critmult.setValue(2);
						end
					end
				</script>
			</list_editor>
			
			<label_fieldtop>
				<anchored to="list" position="aboveleft" offset="5,1" width="60" />
				<static textres="weapon_label_dmgdice" />
			</label_fieldtop>
			<label_fieldtop>
				<anchored to="list" position="aboveleft" offset="85,1" width="130" />
				<static textres="weapon_label_dmgstat" />
			</label_fieldtop>
			<label_fieldtop>
				<anchored to="list" position="aboveleft" offset="220,1" width="50" />
				<static textres="weapon_label_dmgbonus" />
			</label_fieldtop>
			<label_fieldtop>
				<anchored to="list" position="aboveright" offset="5,1" width="40" />
				<static textres="weapon_label_dmgcritmult" />
			</label_fieldtop>
		</sheetdata>
	</windowclass>

	<windowclass name="char_weapon_damage_entry">
		<margins control="0,0,0,2" />
		<sheetdata>
			<anchor_listitem_left_sm />
			<anchor_listitem_right_sm />

			<button_listitem_idelete_left name="idelete">
				<editmode>list_iedit</editmode>
			</button_listitem_idelete_left>

			<dice_listitem_left name="dice">
				<anchored width="60" />
			</dice_listitem_left>
			<label_listitem_left name="label_plus">
				<static>+</static>
			</label_listitem_left>
			<number_listitem_left name="statmult">
				<anchored width="20" />
				<default>1</default>
				<min>0.5</min>
				<wheel>0.5</wheel>
				<hideonvalue>1</hideonvalue>
				<tooltip textres="weapon_tooltip_dmgstatmult" />
			</number_listitem_left>
			<label_listitem_left name="label_statmultx">
				<static>x</static>
			</label_listitem_left>
			<cycler_listitem_ability_left name="stat">
				<parameters>
					<defaultlabelres>dash</defaultlabelres>
				</parameters>
			</cycler_listitem_ability_left>
			<label_listitem_left name="statmaxparen">
				<static>(</static>
			</label_listitem_left>
			<number_listitem_left name="statmax">
				<anchored width="20" />
				<hideonvalue>0</hideonvalue>
				<min>0</min>
				<tooltip textres="weapon_tooltip_dmgstatmax" />
			</number_listitem_left>
			<label_listitem_left name="statmaxparen2">
				<static>)</static>
			</label_listitem_left>
			<label_listitem_left name="label_plus2">
				<static>+</static>
			</label_listitem_left>
			<number_listitem_left name="bonus">
				<anchored width="30" />
				<hideonvalue>0</hideonvalue>
			</number_listitem_left>
			
			<number_listitem_right name="critmult">
				<anchored width="20" />
				<default>1</default>
			</number_listitem_right>
			<label_listitem_right name="label_critmultx">
				<static>x</static>
			</label_listitem_right>
			
			<label name="label_type">
				<anchored position="insidetopleft" offset="20,25" />
				<static textres="weapon_label_dmgtype" />
			</label>
			<stringu name="type">
				<anchored to="label_type" position="righthigh" offset="10,0">
					<right parent="" offset="-5" />
				</anchored>
				<multilinespacing>20</multilinespacing>
			</stringu>
		</sheetdata>
	</windowclass>
</root>
