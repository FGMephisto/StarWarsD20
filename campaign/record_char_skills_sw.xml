<root>
	<windowclass name="charsheet_skills">
		<script>
			function onDrop(x, y, draginfo)
				if draginfo.isType("shortcut") then
					local sClass = draginfo.getShortcutData();
					if sClass == "reference_skill" then
						content.subwindow.content_skills.subwindow.list.addSkillReference(draginfo.getDatabaseNode());
					end
					return true;
				end
			end
		</script>
		<sheetdata>
			<anchor_content_top />
			<anchor_content_bottom />

			<sub_content_framed_groupbox name="content">
				<class>charsheet_skills_contents</class>
			</sub_content_framed_groupbox>
			<scrollbar_content />
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_skills_contents">
		<margins control="0,0,0,2" />
		<script>
			function onInit()
				self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
			end
			function onLockModeChanged(bReadOnly)
				WindowManager.callSafeControlsSetLockMode(self, { "list_iadd", "idelete_header", }, bReadOnly);
			end
		</script>
		<sheetdata>
			<anchor_content_top />
			<anchor_content_bottom />

			<sub_content name="content_skills">
				<class>charsheet_skills_main</class>
			</sub_content>
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_skills_main">
		<margins control="0,0,0,2" />
		<script file="campaign/scripts/char_skills_main_sw.lua" />
		<sheetdata>
			<anchor_content_top />
			<anchor_content_bottom />
			<area_list_content_controls name="area_controls" />
			<anchor_list_content_controls_right name="rightanchor" />
			<filter_list_content_controls>
				<delaykeyupdate merge="delete" />
			</filter_list_content_controls>

			<list_content_labeled name="list">
				<anchored>
					<left offset="5" />
					<right offset="-15" />
				</anchored>
				<datasource>.skilllist</datasource>
				<class>charsheet_skilllist_item</class>
				<classheader>charsheet_skilllist_header</classheader>
				<filter control="filter" />
				<filteron control="name" />
				<sortby><control>sortkey</control></sortby>
				<script file="campaign/scripts/char_skilllist_sw.lua" />
			</list_content_labeled>
			<scrollbar_content_list />

			<anchor_list_content_label_left />
			<anchor_list_content_label_right />

			<spacer_list_content_idelete_label_left name="idelete_header" />
			<spacer_list_content_link_label_left name="label_link" />
			<spacer_list_content_button_checkbox_label_left name="label_skillclass">
				<icon>char_encumbrance</icon>
				<tooltip textres="char_tooltip_skillclass" />
			</spacer_list_content_button_checkbox_label_left>

			<label_list_content_number_right name="label_total">
				<anchored width="44" />
				<static textres="char_label_skilltotal" />
			</label_list_content_number_right>
			<button_details name="activatedetail">
				<anchored to="label_total" position="righthigh" offset="0,0" width="20" height="20" />
				<script>
					function onButtonPress()
						Interface.openWindow("charsheet_skills_detailed", window.getDatabaseNode());
					end
				</script>
			</button_details>
			<spacer_list_content_label_right name="spacer">
				<anchored width="10" />
			</spacer_list_content_label_right>
			<label_list_content_number_right name="label_misc">
				<anchored width="32" />
				<static textres="char_label_skillmisc" />
			</label_list_content_number_right>
			<label_list_content_string_right name="label_ability">
				<anchored width="82" />
				<static textres="char_label_skillability" />
				<center />
			</label_list_content_string_right>
			<label_list_content_number_right name="label_ranks">
				<anchored width="40" />
				<static textres="char_label_skillranks" />
			</label_list_content_number_right>

			<label_list_content_noframe name="label_name">
				<static textres="char_label_skillname" />
			</label_list_content_noframe>
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_skilllist_header">
		<margins control="0,0,0,2" />
		<script file="campaign/scripts/char_skilllist_header_sw.lua" />
		<sheetdata>
			<hs name="group" />
			<hsc name="groupid" />
			<hsc name="sortkey" />

			<anchor_content_top />

			<header_content_framed_rowshade name="label" />
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_skilllist_item">
		<margins control="0,0,0,2" />
		<script file="campaign/scripts/char_skilllist_item_sw.lua" />
		<sheetdata>
			<hn name="armorcheckmultiplier">
				<script>
					function onValueChanged()
						window.onCheckPenaltyChange();
					end
				</script>
			</hn>

			<anchor_listitem_left_sm />
			<anchor_listitem_right_sm />

			<hs name="group" />
			<hsc name="groupid" />
			<hsc name="sortkey" />

			<button_listitem_idelete_left name="idelete" />
			<spacer_listitem_idelete_left name="idelete_spacer" />
			<buttonc_listitem_left name="shortcut">
				<icon normal="button_link" />
				<script file="campaign/scripts/char_skilllink.lua" />
			</buttonc_listitem_left>

			<button_listitem_checkbox_left name="state">
				<script>
					function onValueChanged()
						CharManager.updateSkillPoints(DB.getChild(window.getDatabaseNode(), "..."));
					end
				</script>
			</button_listitem_checkbox_left>
			
			<number_charskilltotal name="total">
				<anchored width="44" />
			</number_charskilltotal>
			<spacer_listitem_right name="spacer">
				<anchored width="10" />
			</spacer_listitem_right>
			<number_charskillfield name="misc">
				<anchored width="32" />
				<tabtarget prev="ranks" />
			</number_charskillfield>
			<number_charskillfield_static name="stat">
				<anchored width="32" />
			</number_charskillfield_static>
			<cycler_charskillability name="statname">
				<anchored width="40" />
				<tabtarget next="ranks" prev="sublabel" />
			</cycler_charskillability>
			<number_charskillranks name="ranks">
				<anchored width="40" />
				<tabtarget next="misc" prev="statname" />
			</number_charskillranks>
			<genericcontrol name="armorwidget">
				<anchored to="rightanchor" width="10" height="10">
					<top offset="5" />
					<right relation="relative" offset="-5" postoffset="-5" />
				</anchored>
			</genericcontrol>

			<string_listitem_center_underline name="label">
				<!-- <tabtarget next="sublabel" /> -->
				<delaykeyupdate />
				<script>
					function onValueChanged()
						window.updateWindow();
					end
				</script>
			</string_listitem_center_underline>
			<stringu name="sublabel">
				<anchored to="label" position="below" height="20" />
				<invisible />
				<tabtarget next="statname" prev="label" />
			</stringu>
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_skills_detailed" copy="charsheethelper_base">
		<script>
			function onDrop(x, y, draginfo)
				if draginfo.isType("shortcut") then
					local sClass = draginfo.getShortcutData();

					if sClass == "reference_skill" then
						content.subwindow.content_main.subwindow.list.addSkillReference(draginfo.getDatabaseNode());
					end
					return true;
				end
			end
		</script>
		<sizelimits>
			<minimum width="1045" height="415" />
		</sizelimits>
		<sheetdata>
			<windowtitlebar_charsheethelper name="title">
				<prefix>char_skill_title</prefix>
			</windowtitlebar_charsheethelper>

			<sub_content_framed_groupbox name="content">
				<class>charsheet_skills_detailed_contents</class>
			</sub_content_framed_groupbox>
			<scrollbar_content />
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_skills_detailed_contents">
		<margins control="0,0,0,2" />
		<sheetdata>
			<anchor_content_top />
			<anchor_content_bottom />

			<sub_content name="content_main">
				<class>charsheet_skills_detailed_main</class>
			</sub_content>
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_skills_detailed_main">
		<script file="campaign/scripts/char_skills_main_sw.lua" />
		<sheetdata>
			<anchor_content_top />
			<anchor_content_bottom />

			<area_list_content_controls name="area_controls" />
			<anchor_list_content_controls_right name="rightanchor" />
			<filter_list_content_controls>
				<delaykeyupdate merge="delete" />
			</filter_list_content_controls>

			<list_content_labeled name="list">
				<anchored>
					<left offset="5" />
					<right offset="-15" />
				</anchored>
				<datasource>.skilllist</datasource>
				<class>charsheet_skilllist_detailed_item</class>
				<classheader>charsheet_skilllist_header</classheader>
				<filter control="filter" />
				<filteron control="name" />
				<sortby>
					<control>sortkey</control>
				</sortby>
				<script file="campaign/scripts/char_skilllist_sw.lua" />
			</list_content_labeled>
			<scrollbar_content_list />

			<anchor_list_content_label_left />
			<anchor_list_content_label_right />

			<spacer_list_content_link_label_left name="iadd_header" />
			<spacer_list_content_link_label_left name="spacer_link" />

			<spacer_list_content_label_right>
				<anchored width="10" />
			</spacer_list_content_label_right>
			<label_list_content_number_right>
				<anchored width="40" />
				<static textres="char_skill_label_total" />
			</label_list_content_number_right>
			<label_list_content_number_right>
				<anchored width="40" />
				<static textres="char_skill_label_ranks_short" />
			</label_list_content_number_right>
			<label_list_content_button_right />
			<label_list_content_number_right>
				<anchored width="40" />
				<static textres="char_skill_label_sb" />
			</label_list_content_number_right>
			<label_list_content_string_right>
				<anchored width="50" />
				<center />
				<static textres="char_skill_label_oml" />
			</label_list_content_string_right>
			<label_list_content_string_right>
				<anchored width="160" />
				<center />
				<static textres="char_skill_label_sunsign" />
			</label_list_content_string_right>
			<label_list_content_string_right>
				<anchored width="130" />
				<center />
				<static textres="char_skill_label_ability" />
			</label_list_content_string_right>
			<label_list_content_string_right>
				<anchored width="100" />
				<center />
				<static textres="char_skill_label_group" />
			</label_list_content_string_right>
			<label_list_content_string_right>
				<anchored width="100" />
				<center />
				<static textres="char_skill_label_name_focus" />
			</label_list_content_string_right>

			<label_list_content name="label_name">
				<static textres="char_skill_label_name" />
			</label_list_content>
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_skilllist_detailed_item">
		<margins control="0,0,0,2" />
		<script file="campaign/scripts/char_skilllist_detailed_item_sw.lua" />
		<sheetdata>
			<anchor_listitem_left />
			<anchor_listitem_right />

			<hsc name="groupid" />
			<hsc name="sortkey" />

			<button_listitem_idelete_left name="idelete" />

			<button_listitem_iadd_left name="iadd">
				<script>
					function onButtonPress()
						window.copySkill();
					end
				</script>
			</button_listitem_iadd_left>

			<buttonc_listitem_left name="shortcut">
				<icon normal="button_link" />
				<script file="campaign/scripts/char_skilllink.lua" />
			</buttonc_listitem_left>

			<spacer_listitem_right name="spacer">
				<anchored width="10" />
			</spacer_listitem_right>

			<number_charskilltotal name="total" />

			<number_listitem_right name="misc">
				<tabtarget prev="ranks" />
				<hideonvalue merge="delete" />
			</number_listitem_right>

			<number_charskillfield_static name="stat">
				<anchored width="32" />
			</number_charskillfield_static>

			<cycler_charskillability name="statname">
				<anchored width="40" />
				<tabtarget next="ranks" prev="group" />
			</cycler_charskillability>

			<number_charskillranks name="ranks">
				<anchored width="40" />
				<tabtarget next="misc" prev="statname" />
			</number_charskillranks>
			<genericcontrol name="armorwidget">
				<anchored to="rightanchor" width="10" height="10">
					<top offset="5" />
					<right relation="relative" offset="-5" postoffset="-5" />
				</anchored>
			</genericcontrol>

			<string_listitem_right name="group">
				<anchored width="100" />
				<center />
				<tabtarget next="statname" prev="sublabel" />
				<delaykeyupdate />
			</string_listitem_right>

			<string_listitem_right name="sublabel">
				<anchored width="100" />
				<center />
				<tabtarget next="group" prev="label" />
				<delaykeyupdate />
			</string_listitem_right>

			<string_listitem_center name="label">
				<tabtarget next="sublabel" />
				<delaykeyupdate />
			</string_listitem_center>
		</sheetdata>
	</windowclass>
</root>