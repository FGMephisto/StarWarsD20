<root>
	<windowclass name="chat" merge="join">
		<sheetdata>
			<basicchatwindow name="chat">
				<droptypes>
					<type merge="add">fullattack</type>
					<type merge="add">attack</type>
					<type merge="add">damage</type>
					<type merge="add">init</type>
					<type merge="add">save</type>
					<type merge="add">ability</type>
					<type merge="add">skill</type>
				</droptypes>
			</basicchatwindow>
		</sheetdata>
	</windowclass>

	<windowclass name="modifierstack" merge="join">
		<sheetdata>
			<genericcontrol name="base">
				<acceptdrop>
					<type merge="add">fullattack</type>
					<type merge="add">attack</type>
					<type merge="add">damage</type>
					<type merge="add">init</type>
					<type merge="add">save</type>
					<type merge="add">ability</type>
					<type merge="add">skill</type>
				</acceptdrop>
			</genericcontrol>
			<numbercontrol name="modifier">
				<droptypes>
					<type merge="add">fullattack</type>
					<type merge="add">attack</type>
					<type merge="add">damage</type>
					<type merge="add">init</type>
					<type merge="add">save</type>
					<type merge="add">ability</type>
					<type merge="add">skill</type>
				</droptypes>
			</numbercontrol>

			<!-- 5E-Style Take 10 Button -->
			<button_modifierkey name="TAKE10">
				<bounds>74,10,60,20</bounds>
			</button_modifierkey>

			<!-- 5E-Style Take 20 Button -->
			<button_modifierkey name="TAKE20">
				<bounds>74,32,60,20</bounds>
			</button_modifierkey>
		</sheetdata>
	</windowclass>
</root>
