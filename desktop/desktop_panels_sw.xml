<?xml version="1.0" encoding="iso-8859-1"?>
<!--
  Star Wars D20 Desktop Panel Layout override
-->
<root>
	<panel name="modifierstack">
		<class>modifierstack</class>
		<anchored width="145" height="62">
			<left offset="5" />
			<top anchor="bottom" offset="-100" />
		</anchored>
		<dynamic />
		<locked />
	</panel>

	<panel name="dicepanel">
		<class>dicepanel</class>
		<anchored width="50" height="50">
			<top anchor="bottom" offset="-105" />
			<left offset="150" />
		</anchored>
		<dynamic />
		<locked />
	</panel>
</root>
